<?xml version="1.0" encoding="utf-8"?>
<!--
  Default 4x1 footprint: just the "Continue Reading" pill (see
  ContinueReadingWidget.kt). Dragging it taller to roughly 4x2 reveals a
  quick-action card row below the pill — see that Kotlin file's class doc.
  This is the app's only home screen widget (a separate fixed-4x2 "verse of
  the day" widget used to exist; deleted once this one's expanded state
  covered the same ground).
  minHeight uses Android's standard single-row cell formula (70dp * 1 - 30dp).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_loading"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/continue_reading_widget_description" />
