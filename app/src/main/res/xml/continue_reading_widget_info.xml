<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed 4x1 widget: just the "Continue Reading" pill (see
  ContinueReadingWidget.kt), a separate pick from the widget picker rather
  than a resize target of the 4x2 verse_of_day_widget_info widget — see
  that Kotlin file's class doc for why. minHeight uses Android's standard
  single-row cell formula (70dp * 1 - 30dp).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_loading"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/continue_reading_widget_description" />
