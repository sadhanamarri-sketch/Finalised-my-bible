<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is just a fallback/safety-net refresh — Android's
  actual enforced floor for this value is 30 minutes regardless of what's
  set here, so it's set to that floor rather than a misleadingly larger
  number. The real-time trigger is MainViewModel.refreshContinueReadingWidget()
  calling VerseOfDayWidget().updateAll(context) immediately on every
  chapter change, so "Continue reading" updates right away in normal use;
  this periodic cycle only matters if that call is ever missed (e.g. app
  process killed before it runs).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_loading"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/verse_widget_description" />
